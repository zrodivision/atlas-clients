{
  "name": "@zrodivision/atlas-clients",
  "private": true,
  "version": "0.14.2-rc.2",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "atlas": "tsx scripts/atlas.ts",
    "check": "tsc --noEmit",
    "format:check": "prettier --check \"scripts/**/*.ts\"",
    "test": "npm run test:client-package && npm run test:mcp-install && npm run test:cli-package && npm run test:signal-contract && npm run test:worker-cli && npm run test:distribution && npm run test:login-readiness && npm run test:inspection && npm run test:memory-guide && npm run test:first-session && npm run test:setup-guide && npm run test:sdk-security",
    "test:client-package": "tsx scripts/client-package-tests.ts",
    "test:mcp-install": "tsx scripts/mcp-install-tests.ts",
    "test:cli-package": "tsx scripts/cli-package-tests.ts",
    "package:client": "tsx scripts/client-package.ts build",
    "package:hosted": "tsx scripts/client-package.ts build-hosted https://connectatlas.io",
    "package:cli": "tsx scripts/package-cli.ts",
    "package:release": "tsx scripts/package-release.ts",
    "client:status": "tsx scripts/client-package.ts status",
    "client:install-skill": "tsx scripts/client-package.ts install-skill",
    "client:package-status": "tsx scripts/client-package.ts package-status",
    "plugins:generate": "tsx scripts/generate-plugins.ts",
    "package:native": "tsx scripts/package-native.ts",
    "test:native": "npm run test:node-runtime && tsx scripts/native-install-tests.ts",
    "test:node-runtime": "tsx scripts/node-runtime-tests.ts",
    "test:signal-contract": "tsx scripts/signal-contract-tests.ts",
    "test:worker-cli": "tsx scripts/worker-cli-tests.ts",
    "test:distribution": "tsx scripts/distribution-tests.ts",
    "test:login-readiness": "tsx scripts/cli-oauth-readiness-tests.ts",
    "test:inspection": "tsx scripts/inspection-tests.ts",
    "test:memory-guide": "tsx scripts/memory-guidance-tests.ts",
    "test:first-session": "tsx scripts/first-session-tests.ts",
    "test:setup-guide": "tsx scripts/setup-guidance-tests.ts",
    "test:sdk-security": "tsx scripts/sdk-security-tests.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "6.0.3"
  }
}
